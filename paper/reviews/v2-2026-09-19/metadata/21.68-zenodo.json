{"created": "2026-09-14T14:16:59.981550+00:00", "modified": "2026-09-14T14:17:00.343559+00:00", "id": 22751482, "conceptrecid": "22751481", "doi": "10.5281/zenodo.22751482", "conceptdoi": "10.5281/zenodo.22751481", "doi_url": "https://doi.org/10.5281/zenodo.22751482", "metadata": {"title": "An irreducible nonmonomial representation of degree eight in a semiabelian group of order 2592", "doi": "10.5281/zenodo.22751482", "publication_date": "2026-09-14", "description": "<p>We construct a semiabelian group \\(G\\) of order \\(2592\\) with an irreducible complex representation of degree eight which is not induced from a linear character of any subgroup. Write \\(M=C_2^3\\rtimes A_4\\) as a signed permutation group and choose \\(K\\leq M\\) with \\(K\\cong Q_8\\rtimes C_3\\) and \\([M:K]=4\\). The group \\(G\\) is the semidirect product of the augmentation module of \\(\\mathbb F_3[M/K]\\) by \\(M\\). A coordinate character and the irreducible quaternionic representation of \\(K\\) give the degree-eight representation. Any monomial realization would produce a subgroup of index two in \\(K\\), which does not exist. This disproves the assertion in Kourovka Problem 21.68 that every finite semiabelian group is monomial.</p>", "access_right": "open", "creators": [{"name": "Jayadevan, Achyuth", "affiliation": "Manipal Institute of Technology, MAHE", "orcid": "0009-0008-8745-4078"}], "version": "1.0.0", "language": "eng", "custom": {"code:codeRepository": "https://github.com/Achxy/kourovka-llm-langgraph-benchmarks", "code:developmentStatus": {"id": "active", "title": {"en": "Active"}}}, "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "22751481"}}]}}, "title": "An irreducible nonmonomial representation of degree eight in a semiabelian group of order 2592", "links": {"self": "https://zenodo.org/api/records/22751482", "self_html": "https://zenodo.org/records/22751482", "preview_html": "https://zenodo.org/records/22751482?preview=1", "doi": "https://doi.org/10.5281/zenodo.22751482", "self_doi": "https://doi.org/10.5281/zenodo.22751482", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.22751482", "reserve_doi": "https://zenodo.org/api/records/22751482/draft/pids/doi", "parent": "https://zenodo.org/api/records/22751481", "parent_html": "https://zenodo.org/records/22751481", "parent_doi": "https://doi.org/10.5281/zenodo.22751481", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.22751481", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:22751482/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:22751482/sequence/default", "files": "https://zenodo.org/api/records/22751482/files", "media_files": "https://zenodo.org/api/records/22751482/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:22751482:kourovka-21-68-paper.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:22751482:kourovka-21-68-paper.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:22751482:kourovka-21-68-paper.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:22751482:kourovka-21-68-paper.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:22751482:kourovka-21-68-paper.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:22751482:kourovka-21-68-paper.pdf/full/%5E1200,/0/default.jpg"}, "archive": "https://zenodo.org/api/records/22751482/files-archive", "archive_media": "https://zenodo.org/api/records/22751482/media-files-archive", "latest": "https://zenodo.org/api/records/22751482/versions/latest", "latest_html": "https://zenodo.org/records/22751482/latest", "versions": "https://zenodo.org/api/records/22751482/versions", "draft": "https://zenodo.org/api/records/22751482/draft", "access_links": "https://zenodo.org/api/records/22751482/