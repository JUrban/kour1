{"created": "2026-09-14T14:15:52.264365+00:00", "modified": "2026-09-14T14:15:52.593197+00:00", "id": 22751423, "conceptrecid": "22751422", "doi": "10.5281/zenodo.22751423", "conceptdoi": "10.5281/zenodo.22751422", "doi_url": "https://doi.org/10.5281/zenodo.22751423", "metadata": {"title": "A nonsplit extension of a product of free groups by the additive group of a countable division ring", "doi": "10.5281/zenodo.22751423", "publication_date": "2026-09-14", "description": "<p>We construct a countable division ring \\(D\\) of characteristic zero, a subgroup \\(G\\leq D^\\times\\) isomorphic to \\(F_2\\times F_2\\), and a nonsplit extension \\(1\\to D^+\\to E\\to G\\to1\\) inducing the action \\(g\\cdot u=gu\\). Both \\(G\\) and \\(E\\) are torsion-free. The factor set is the cup product of two explicitly prescribed free-group derivations. Four commutation equations for the lifts of the free generators force \\(0=1\\) if a section exists. This gives a negative answer to Kourovka Problem 18.76.</p>", "access_right": "open", "creators": [{"name": "Jayadevan, Achyuth", "affiliation": "Manipal Institute of Technology, MAHE", "orcid": "0009-0008-8745-4078"}], "version": "1.0.0", "language": "eng", "custom": {"code:codeRepository": "https://github.com/Achxy/kourovka-llm-langgraph-benchmarks", "code:developmentStatus": {"id": "active", "title": {"en": "Active"}}}, "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "22751422"}}]}}, "title": "A nonsplit extension of a product of free groups by the additive group of a countable division ring", "links": {"self": "https://zenodo.org/api/records/22751423", "self_html": "https://zenodo.org/records/22751423", "preview_html": "https://zenodo.org/records/22751423?preview=1", "doi": "https://doi.org/10.5281/zenodo.22751423", "self_doi": "https://doi.org/10.5281/zenodo.22751423", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.22751423", "reserve_doi": "https://zenodo.org/api/records/22751423/draft/pids/doi", "parent": "https://zenodo.org/api/records/22751422", "parent_html": "https://zenodo.org/records/22751422", "parent_doi": "https://doi.org/10.5281/zenodo.22751422", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.22751422", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:22751423/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:22751423/sequence/default", "files": "https://zenodo.org/api/records/22751423/files", "media_files": "https://zenodo.org/api/records/22751423/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:22751423:kourovka-18-76-paper.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:22751423:kourovka-18-76-paper.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:22751423:kourovka-18-76-paper.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:22751423:kourovka-18-76-paper.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:22751423:kourovka-18-76-paper.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:22751423:kourovka-18-76-paper.pdf/full/%5E1200,/0/default.jpg"}, "archive": "https://zenodo.org/api/records/22751423/files-archive", "archive_media": "https://zenodo.org/api/records/22751423/media-files-archive", "latest": "https://zenodo.org/api/records/22751423/versions/latest", "latest_html": "https://zenodo.org/records/22751423/latest", "versions": "https://zenodo.org/api/records/22751423/versions", "draft": "https://zenodo.org/api/records/22751423/draft", "access_links": "https://zenodo.org/api/records/22751423/access/links", "access_grants": "https://zenodo.org/api/records/22751423/access/grants", "access_users": "https://zenodo.org/api/records/22751423/access/users", "access_request": "https://zenodo.org/api/records/22751423