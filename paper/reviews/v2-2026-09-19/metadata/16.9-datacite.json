{"data":{"id":"10.5281/zenodo.22722079","type":"dois","attributes":{"doi":"10.5281/zenodo.22722079","prefix":"10.5281","suffix":"zenodo.22722079","identifiers":[{"identifier":"oai:zenodo.org:22722079","identifierType":"oai"}],"alternateIdentifiers":[{"alternateIdentifierType":"oai","alternateIdentifier":"oai:zenodo.org:22722079"}],"creators":[{"name":"Jayadevan, Achyuth","nameType":"Personal","givenName":"Achyuth","familyName":"Jayadevan","affiliation":["Manipal Institute of Technology, MAHE"],"nameIdentifiers":[{"nameIdentifier":"0009-0008-8745-4078","nameIdentifierScheme":"ORCID"}]}],"titles":[{"title":"Palindromic length in free groups through reflection length and noncrossing matchings"}],"publisher":"Zenodo","container":{},"publicationYear":2026,"subjects":[{"subject":"Kourovka Problem 16.9"},{"subject":"Palindromic length"},{"subject":"Free groups"},{"subject":"Reflection length"},{"subject":"Noncrossing matchings"},{"subject":"Lean 4"}],"contributors":[],"dates":[{"date":"2026-09-12","dateType":"Issued"}],"language":"en","types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.22722078","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1.0.0","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"},{"rights":"Copyright © 2026 Achyuth Jayadevan.","rightsUri":"http://rightsstatements.org/vocab/InC/1.0/"}],"descriptions":[{"description":"We express palindromic length in a finitely generated free group as the minimum of two reflection lengths in a universal Coxeter group. The identity converts optimal reflection factorizations into optimal palindromic factorizations. Combined with the classical cancellation-norm recurrence, it gives a concrete algorithm with \\(O(L^3)\\) arithmetic and symbol operations, \\(O(L^2)\\) table entries and \\(O(L^2)\\) written output for a reduced input of length \\(L\u003e0\\). Qualitative computability already follows from Dahmani–Guirardel's theorem on twisted equations; the present construction supplies the explicit reduction and quantitative algorithm. The length identity, solver correctness and optimality, and explicit counting bounds are formalised in Lean 4.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://zenodo.org/doi/10.5281/zenodo.22722079","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-09-12T21:08:00.000Z","registered":"2026-09-12T21:08:00.000Z","published":"2026","updated":"2026-09-12T21:08:00.000Z"},"relationships":{"client":{"data":{"id":"cern.zenodo","type":"clients"}},"provider":{"data":{"id":"cern","type":"providers"}},"media":{"data":{"id":"10.5281/zenodo.22722079","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[{"id":"10.5281/zenodo.22722078","type":"dois"}]}}}}